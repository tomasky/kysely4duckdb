{
  "name": "kysely4duckdb",
  "version": "0.5.3",
  "description": "kysely dialect for duckdb",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./wasm": {
      "types": "./dist/wasm.d.ts",
      "import": "./dist/wasm.js",
      "require": "./dist/wasm.cjs"
    },
    "./wasm-node": {
      "types": "./dist/wasm-node.d.ts",
      "import": "./dist/wasm-node.js",
      "require": "./dist/wasm-node.cjs"
    }
  },
  "scripts": {
    "test": "jest",
    "build": "rimraf ./dist && tsup src/index.ts src/wasm.ts src/wasm-node.ts --format cjs,esm --dts",
    "check": "tsc --noEmit",
    "docs": "typedoc src/index.ts",
    "all": "pnpm run check && pnpm run test && pnpm run build && pnpm run docs"
  },
  "keywords": [
    "kysely",
    "kysely-dialect",
    "duckdb"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tomasky/kysely-duckdb"
  },
  "author": "runoshun",
  "license": "MIT",
  "devDependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "@duckdb/node-api": "1.5.5-r.5",
    "@tsconfig/node18": "^18.2.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.2",
    "dprint": "^0.41.0",
    "jest": "^30.5.2",
    "kysely": "^0.29.6",
    "rimraf": "^5.0.10",
    "ts-jest": "^29.4.13",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "web-worker": "1.5.0"
  },
  "peerDependencies": {
    "@duckdb/duckdb-wasm": "*",
    "@duckdb/node-api": "*",
    "kysely": "^0.29.6",
    "web-worker": "*"
  },
  "peerDependenciesMeta": {
    "@duckdb/duckdb-wasm": {
      "optional": true
    },
    "@duckdb/node-api": {
      "optional": true
    },
    "web-worker": {
      "optional": true
    }
  }
}
